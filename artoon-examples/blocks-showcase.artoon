>.t3:: 2️⃣ CODE Block - أكواد البرمجة

>.p:: بلوك CODE يُستخدم لعرض أكواد البرمجة. المحتوى داخله لا يُحلل كـ ARTOON syntax.

>.t4:: كود JavaScript

<code:javascript>.
// دالة بسيطة
function greet(name) {
  return `مرحباً ${name}!`;
}

// استخدام الدالة
const message = greet('ARTOON');
console.log(message);

// دالة async
const fetchData = async (url) => {
  try {
    const response = await fetch(url);
    return await response.json();
  } catch (error) {
    console.error('خطأ:', error);
  }
};
.<code>

>.t4:: كود Python

<code:python>.
# مثال على Python
def calculate_sum(numbers):
    """حساب مجموع الأرقام"""
    return sum(numbers)

# استخدام الدالة
numbers = [1, 2, 3, 4, 5]
result = calculate_sum(numbers)
print(f"المجموع: {result}")

# Class مثال
class Calculator:
    def __init__(self):
        self.result = 0
    
    def add(self, x, y):
        self.result = x + y
        return self.result
.<code>

>.t4:: كود TypeScript

<code:typescript>.
// TypeScript interfaces
interface User {
  id: number;
  name: string;
  email: string;
  role: 'admin' | 'user';
}

// Generic function
function findById<T extends { id: number }>(
  items: T[],
  id: number
): T | undefined {
  return items.find(item => item.id === id);
}

// Usage
const users: User[] = [
  { id: 1, name: 'أحمد', email: 'ahmad@example.com', role: 'admin' }
];

const user = findById(users, 1);
.<code>

>.t4:: كود HTML/CSS

<code:html>.
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <title>مثال ARTOON</title>
  <style>
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 20px;
      direction: rtl;
    }
    .header {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      padding: 40px;
      border-radius: 10px;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>مرحباً بك في ARTOON</h1>
    </div>
  </div>
</body>
</html>
.<code>

>.t4:: كود SQL

<code:sql>.
-- إنشاء جدول
CREATE TABLE articles (
  id INT PRIMARY KEY AUTO_INCREMENT,
  title VARCHAR(200) NOT NULL,
  content TEXT,
  author_id INT,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (author_id) REFERENCES users(id)
);

-- استعلام متقدم
SELECT 
  a.title,
  u.name as author_name,
  COUNT(c.id) as comment_count
FROM articles a
LEFT JOIN users u ON a.author_id = u.id
LEFT JOIN comments c ON a.id = c.article_id
GROUP BY a.id
HAVING comment_count > 10
ORDER BY created_at DESC
LIMIT 20;
.<code>

