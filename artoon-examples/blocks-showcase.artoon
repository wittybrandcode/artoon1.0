>.t4:: كود YAML

<code:yaml>.
# ملف تكوين ARTOON
project:
  name: ARTOON 2.0
  version: 2.0.0
  language: ar
  direction: rtl

features:
  - name: META blocks
    status: implemented
    tests: 28
  - name: Custom blocks
    status: implemented
    tests: unlimited
  - name: Code blocks
    status: implemented
    languages:
      - javascript
      - python
      - typescript
      - html
      - css
      - sql

settings:
  parser:
    strict: true
    validate: true
  renderer:
    format: html
    minify: false
.<code>

>.t4:: كود Bash/Shell

<code:bash>.
#!/bin/bash

# سكريبت بناء ARTOON
echo "🚀 بدء بناء ARTOON 2.0..."

# بناء Parser
cd artoon-parser
npm run build
echo "✅ Parser تم بناؤه"

# بناء Renderer
cd ../artoon-renderer-html
npm run build
echo "✅ Renderer تم بناؤه"

# بناء Serializer
cd ../artoon-serializer
npm run build
echo "✅ Serializer تم بناؤه"

# بناء Editor
cd ../artoon-typer
npm run build
echo "✅ Editor تم بناؤه"

echo "🎉 اكتمل البناء بنجاح!"
