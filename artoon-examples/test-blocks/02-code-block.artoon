>.hr

>.t2:: اختبار JavaScript

<code:javascript>.
// دالة بسيطة
function greet(name) {
  return `مرحباً ${name}!`;
}

const message = greet('ARTOON');
console.log(message);
.<code>

>.t2:: اختبار Python

<code:python>.
def calculate_sum(numbers):
    """حساب مجموع الأرقام"""
    return sum(numbers)

numbers = [1, 2, 3, 4, 5]
result = calculate_sum(numbers)
print(f"المجموع: {result}")
.<code>

>.t2:: اختبار TypeScript

<code:typescript>.
interface User {
  id: number;
  name: string;
  email: string;
}

function findById<T extends { id: number }>(
  items: T[],
  id: number
): T | undefined {
  return items.find(item => item.id === id);
}
.<code>

