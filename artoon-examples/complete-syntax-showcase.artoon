>.t2:: ١٥. الكود (Code)

<code:javascript>.
// مثال JavaScript
const greeting = 'مرحباً بالعالم';
console.log(greeting);

function calculateSum(a, b) {
  return a + b;
}
.<code>

<code:python>.
# مثال Python
def greet(name):
    return f"مرحباً {name}"

class Calculator:
    def add(self, a, b):
        return a + b
.<code>

<code:typescript>.
// مثال TypeScript
interface User {
  id: string;
  name: string;
  email: string;
}

const createUser = (data: Partial<User>): User => ({
  id: generateId(),
  name: data.name ?? 'مستخدم',
  email: data.email ?? '',
});
.<code>

<code>.
كود بدون تحديد لغة
يمكن أن يحتوي على أي نص
.<code>

