{
  "name": "@artoon/renderer-html",
  "version": "1.0.0",
  "description": "ARTOON HTML Renderer - supports unified types",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "artoon",
    "renderer",
    "html"
  ],
  "license": "MIT",
  "dependencies": {
    "@artoon/ast": "file:../artoon-ast",
    "@artoon/core": "file:../artoon-core"
  },
  "devDependencies": {
    "@artoon/parser": "file:../artoon-parser",
    "@artoon/state": "file:../artoon-state",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typescript": "^5.0.0"
  }
}
