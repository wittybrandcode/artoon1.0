{
  "name": "artoon-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "ARTOON 2.0 - Monorepo for all ARTOON packages",
  "workspaces": [
    "artoon-ast",
    "artoon-parser",
    "artoon-serializer",
    "artoon-validator",
    "artoon-renderer-html",
    "artoon-cli",
    "artoon-state",
    "artoon-typer", "artoon-core"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:core": "npm run build -w artoon-ast && npm run build -w artoon-parser && npm run build -w artoon-serializer",
    "test": "npm run test --workspaces --if-present",
    "test:contracts": "jest --testPathPattern=tests/contracts --runInBand --passWithNoTests",
    "test:ast": "npm test -w artoon-ast",
    "test:parser": "npm test -w artoon-parser",
    "test:serializer": "npm test -w artoon-serializer",
    "test:renderer": "npm test -w artoon-renderer-html",
    "test:validator": "npm test -w artoon-validator",
    "test:state": "npm test -w artoon-state",
    "test:typer": "npm test -w artoon-typer",
    "test:full": "npm run test --workspaces --if-present",
    "test:migration": "npm run test:contracts && npm run test:full",
    "backup": "scripts\\backup-types.bat",
    "clean": "rimraf */dist */node_modules node_modules"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "rimraf": "^5.0.0"
  }
}
