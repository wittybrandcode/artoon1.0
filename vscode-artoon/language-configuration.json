{
  "comments": {
    "lineComment": ">.:::"
  },
  "brackets": [
    ["[", "]"],
    ["<", ">"]
  ],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "<", "close": ">" }
  ],
  "surroundingPairs": [
    ["[", "]"]
  ],
  "folding": {
    "markers": {
      "start": "^<[a-zA-Z0-9:_-]+>\\.$",
      "end": "^\\.<[a-zA-Z0-9_-]+>$"
    }
  },
  "wordPattern": "[a-zA-Z0-9_\\u0600-\\u06FF]+"
}
