{
    "name":  "vscode-artoon",
    "displayName":  "ARTOON Language Support",
    "description":  "Language support for ARTOON with completion, diagnostics, hover, symbols, folding, commands, and formatting",
    "version":  "1.0.0",
    "publisher":  "artoon",
    "engines":  {
                    "vscode":  "^1.85.0"
                },
    "categories":  [
                       "Programming Languages"
                   ],
    "keywords":  [
                     "artoon",
                     "semantic",
                     "markup",
                     "rtl",
                     "arabic"
                 ],
    "activationEvents":  [
                             "onLanguage:artoon",
                             "onCommand:artoon.validateDocument",
                             "onCommand:artoon.showDocumentStats",
                             "onCommand:artoon.newSample"
                         ],
    "main":  "./dist/extension.js",
    "contributes":  {
                        "languages":  [
                                          {
                                              "id":  "artoon",
                                              "aliases":  [
                                                              "ARTOON",
                                                              "artoon"
                                                          ],
                                              "extensions":  [
                                                                 ".artoon",
                                                                 ".toon"
                                                             ],
                                              "configuration":  "./language-configuration.json",
                                              "icon":  {
                                                           "light":  "./images/artoon-icon.svg",
                                                           "dark":  "./images/artoon-icon.svg"
                                                       }
                                          }
                                      ],
                         "snippets": [{"language": "artoon", "path": "./snippets/artoon.json"}],
"grammars":  [
                                         {
                                             "language":  "artoon",
                                             "scopeName":  "source.artoon",
                                             "path":  "./syntaxes/artoon.tmLanguage.json"
                                         }
                                     ],
                        "commands":  [
                                         {
                                             "command":  "artoon.validateDocument",
                                             "title":  "ARTOON: Validate Document"
                                         },
                                         {
                                             "command":  "artoon.showDocumentStats",
                                             "title":  "ARTOON: Show Document Stats"
                                         },
                                         {
                                             "command":  "artoon.newSample",
                                             "title":  "ARTOON: New Sample Document"
                                         }
                                     ],
                        "configuration":  {
                                              "title":  "ARTOON",
                                              "properties":  {
                                                                 "artoon.validation.enabled":  {
                                                                                                   "type":  "boolean",
                                                                                                   "default":  true,
                                                                                                   "description":  "Enable real-time parser and validator diagnostics for ARTOON files."
                                                                                               },
                                                                 "artoon.validation.strict":  {
                                                                                                  "type":  "boolean",
                                                                                                  "default":  false,
                                                                                                  "description":  "Treat warnings as errors during validation."
                                                                                              }
                                                             }
                                          },
                        "configurationDefaults":  {
                                                      "[artoon]":  {
                                                                       "editor.wordWrap":  "on",
                                                                       "editor.quickSuggestions":  {
                                                                                                       "strings":  true
                                                                                                   },
                                                                       "cSpell.enabled":  false,
                                                                       "cSpell.enableFiletypes":  [
                                                                                                      "!artoon"
                                                                                                  ],
                                                                       "editor.unicodeHighlight.ambiguousCharacters":  false,
                                                                       "editor.unicodeHighlight.nonBasicASCII":  false,
                                                                       "editor.semanticHighlighting.enabled":  false
                                                                   }
                                                  }
                    },
    "scripts":  {
                    "build":  "tsc -p ./ --noEmit \u0026\u0026 node scripts/build.js",
                    "watch":  "tsc -watch -p ./ --noEmit",
                    "vscode:prepublish":  "npm run build",
                    "package":  "vsce package --no-dependencies --allow-missing-repository --out vscode-artoon-1.0.0.vsix"
                },
    "dependencies":  {
                         "@artoon/ast":  "file:../artoon-ast",
                         "@artoon/parser":  "file:../artoon-parser",
                         "@artoon/serializer":  "file:../artoon-serializer",
                         "@artoon/validator":  "file:../artoon-validator"
                     },
    "devDependencies":  {
                            "@types/node":  "^20.10.0",
                            "@types/vscode":  "^1.85.0",
                            "@vscode/vsce":  "^3.6.0",
                            "esbuild":  "^0.28.0",
                            "typescript":  "^5.3.0"
                        }
}